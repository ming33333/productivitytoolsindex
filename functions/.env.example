# true = Stripe test cards. false = real charges.
# Keep this in sync with LOCAL_TESTING in the root .env file.
LOCAL_TESTING=true

# Stripe test (LOCAL_TESTING=true)
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...
STRIPE_TEST_PRICE_ID=price_...
STRIPE_TEST_YEARLY_PRICE_ID=price_...

# Stripe live (LOCAL_TESTING=false)
STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_LIVE_WEBHOOK_SECRET=whsec_...
STRIPE_LIVE_PRICE_ID=price_...
STRIPE_LIVE_YEARLY_PRICE_ID=price_...
