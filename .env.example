# Firebase web app
# Firebase Console → Project settings → Your apps → Web app
REACT_APP_FIREBASE_API_KEY=your_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Google Analytics 4. Same value as measurementId in the Firebase web config.
REACT_APP_FIREBASE_MEASUREMENT_ID=G-...

# true = Stripe test cards. false = real charges.
LOCAL_TESTING=true

# Stripe test (LOCAL_TESTING=true)
REACT_APP_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
REACT_APP_STRIPE_TEST_PRICE_ID=price_...
REACT_APP_STRIPE_TEST_YEARLY_PRICE_ID=price_...

# Stripe live (LOCAL_TESTING=false)
REACT_APP_STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_...
REACT_APP_STRIPE_LIVE_PRICE_ID=price_...
REACT_APP_STRIPE_LIVE_YEARLY_PRICE_ID=price_...

# Optional. Leave blank to use
# https://us-central1-<projectId>.cloudfunctions.net
# Local emulator: http://localhost:5001/YOUR_PROJECT_ID/us-central1
REACT_APP_CLOUD_FUNCTIONS_URL=
