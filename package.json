{
  "name": "site-template",
  "private": true,
  "version": "1.0.0",
  "homepage": "https://productivitytoolsindex.com",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "clone": "node scripts/clone-site.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "deploy": "npm run build && gh-pages -d build",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:functions": "node scripts/deploy-functions.mjs",
    "seed": "node scripts/seed-firestore.mjs"
  },
  "dependencies": {
    "@stripe/stripe-js": "^2.4.0",
    "firebase": "^11.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-tools": "^14.11.0",
    "gh-pages": "^6.3.0",
    "vite": "^6.3.5"
  }
}
